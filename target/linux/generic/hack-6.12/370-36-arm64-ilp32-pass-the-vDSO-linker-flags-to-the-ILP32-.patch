From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: liviyifan <344781483+liviyifan@users.noreply.github.com>
Date: Mon, 19 Oct 2026 23:07:55 +0800
Subject: [PATCH] arm64: ilp32: pass the vDSO linker flags to the ILP32 vDSO
 link

The ILP32 vDSO is linked through $(CC), so that -mabi=ilp32 selects the
ELF32 emulation, but the link command does not use ldflags-y: only
-shared and -n reach the linker, and --hash-style=sysv, -Bsymbolic,
--no-eh-frame-hdr, --build-id and -z force-bti (BTI kernels) are lost.
The ccflags-y line meant to pass --hash-style=sysv uses cc-ldoption,
which no longer exists in Kbuild and expands to nothing.

As a result the ILP32 vDSO has DT_GNU_HASH but no DT_HASH, and no
DF_SYMBOLIC, unlike the LP64 vDSO. glibc handles DT_GNU_HASH, but vDSO
parsers that only read DT_HASH, such as
tools/testing/selftests/vDSO/parse_vdso.c, find no symbols.

Pass ldflags-y with -Wl, to the $(CC) link and drop the cc-ldoption
call. The ILP32 vDSO now has DT_HASH, DF_SYMBOLIC and a build ID, like
the LP64 one.

The same Makefile is in openEuler OLK-5.10 and OLK-6.6.

Signed-off-by: liviyifan <344781483+liviyifan@users.noreply.github.com>
(cherry picked from commit d9fd1a8bb275c1074efe80b86e1d8495261b2c1f)
(cherry picked from commit 16ae466178fedc106bcfcb03e45e0264f8d406a2)
---
 arch/arm64/kernel/vdso-ilp32/Makefile | 10 +++++++---
 1 file changed, 7 insertions(+), 3 deletions(-)

--- a/arch/arm64/kernel/vdso-ilp32/Makefile
+++ b/arch/arm64/kernel/vdso-ilp32/Makefile
@@ -30,8 +30,7 @@ ldflags-y := -shared -nostdlib -soname=l
 ccflags-y := -fno-common -fno-builtin -fno-stack-protector -ffixed-x18
 ccflags-y += -DDISABLE_BRANCH_PROFILING
 #ccflags-y += -nostdlib
-ccflags-y += -nostdlib -Wl,-soname=linux-ilp32-vdso.so.1 \
-		$(call cc-ldoption, -Wl$(comma)--hash-style=sysv)
+ccflags-y += -nostdlib -Wl,-soname=linux-ilp32-vdso.so.1
 
 # as the LP64 vDSO: no ftrace, SCS, randstruct, plugins, LTO or CFI, and no -Wmissing-prototypes or
 # -Wmissing-declarations so that CONFIG_WERROR builds
@@ -100,8 +99,13 @@ $(obj)/sigreturn-ilp32.o: $(src)/../vdso
 	$(call if_changed_dep,vdso-ilp32as)
 
 # Actual build commands
+# The vDSO is linked through $(CC) (-mabi=ilp32 selects the ELF32 emulation), so ldflags-y is passed with
+# -Wl, like the LP64 vDSO gets it through $(LD). -shared is also given to the driver itself, which would
+# otherwise add -pie when it defaults to PIE.
+ldflags-ilp32 := $(addprefix -Wl$(comma),$(filter-out -T,$(ldflags-y)))
 quiet_cmd_vdso-ilp32ld_and_vdso_check = LD      $@
-      cmd_vdso-ilp32ld_and_vdso_check = $(CC) $(c_flags) -mabi=ilp32 -shared -Wl,-n -Wl,-T $(real-prereqs) -o $@
+      cmd_vdso-ilp32ld_and_vdso_check = $(CC) $(c_flags) -mabi=ilp32 -shared $(ldflags-ilp32) \
+					  -Wl,-T $(real-prereqs) -o $@
 quiet_cmd_vdso-ilp32cc = VDSOILP32C $@
       cmd_vdso-ilp32cc= $(CC) $(c_flags) -mabi=ilp32 -c -o $@ $<
 quiet_cmd_vdso-ilp32as = VDSOILP32A $@
