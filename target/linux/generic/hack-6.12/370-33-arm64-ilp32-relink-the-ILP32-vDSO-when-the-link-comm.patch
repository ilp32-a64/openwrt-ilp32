From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: liviyifan <344781483+liviyifan@users.noreply.github.com>
Date: Sat, 17 Oct 2026 18:11:29 +0800
Subject: [PATCH] arm64: ilp32: relink the ILP32 vDSO when the link command
 changes

The link rule had no FORCE prerequisite, so if_changed never saw a
changed command line and kept a stale vdso-ilp32.so. Add FORCE and use
$(real-prereqs), as the LP64 vDSO Makefile does.

Signed-off-by: liviyifan <344781483+liviyifan@users.noreply.github.com>
(cherry picked from commit 075988a02ebc2694fb72f006f66ab4c2b582eef2)
(cherry picked from commit b0b6636085fc16be56b550a38632c5fc58d7002d)
---
 arch/arm64/kernel/vdso-ilp32/Makefile | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

--- a/arch/arm64/kernel/vdso-ilp32/Makefile
+++ b/arch/arm64/kernel/vdso-ilp32/Makefile
@@ -72,7 +72,7 @@ CPPFLAGS_vdso-ilp32.lds += -P -C -U$(ARC
 $(obj)/vdso-ilp32.o : $(obj)/vdso-ilp32.so
 
 # Link rule for the .so file, .lds has to be first
-$(obj)/vdso-ilp32.so.dbg: $(obj)/vdso-ilp32.lds $(obj-ilp32-vdso)
+$(obj)/vdso-ilp32.so.dbg: $(obj)/vdso-ilp32.lds $(obj-ilp32-vdso) FORCE
 	$(call if_changed,vdso-ilp32ld_and_vdso_check)
 
 # Strip rule for the .so file
@@ -99,7 +99,7 @@ $(obj)/sigreturn-ilp32.o: $(src)/../vdso
 
 # Actual build commands
 quiet_cmd_vdso-ilp32ld_and_vdso_check = LD      $@
-      cmd_vdso-ilp32ld_and_vdso_check = $(CC) $(c_flags) -mabi=ilp32 -shared -Wl,-n -Wl,-T $^ -o $@
+      cmd_vdso-ilp32ld_and_vdso_check = $(CC) $(c_flags) -mabi=ilp32 -shared -Wl,-n -Wl,-T $(real-prereqs) -o $@
 quiet_cmd_vdso-ilp32cc = VDSOILP32C $@
       cmd_vdso-ilp32cc= $(CC) $(c_flags) -mabi=ilp32 -c -o $@ $<
 quiet_cmd_vdso-ilp32as = VDSOILP32A $@
