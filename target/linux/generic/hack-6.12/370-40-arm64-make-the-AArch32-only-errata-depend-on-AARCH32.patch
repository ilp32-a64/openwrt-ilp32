From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: liviyifan <344781483+liviyifan@users.noreply.github.com>
Date: Tue, 20 Oct 2026 02:06:13 +0800
Subject: [PATCH] arm64: make the AArch32-only errata depend on AARCH32_EL0

With the ILP32 series, COMPAT is set when AARCH32_EL0 or ARM64_ILP32 is
enabled, and AARCH32_EL0 is the option for AArch32 tasks. The errata
added or kept with "depends on COMPAT" after that split still use the
old meaning, so with ARM64_ILP32=y and AARCH32_EL0=n:

- ARM64_ERRATUM_1742098 (AArch32 AES instructions) clears a bit in
  a32_elf_hwcap2, which then does not exist:
  arch/arm64/kernel/cpufeature.c: error: 'a32_elf_hwcap2' undeclared
- ARM64_ERRATUM_1418040 (AArch32 generic timer reads) is built for no
  AArch32 task;
- ARCH_MXC selects ARM64_ERRATUM_845719, which depends on AARCH32_EL0:
  "unmet direct dependencies detected for ARM64_ERRATUM_845719".

Use AARCH32_EL0 for these three, and fix the comment of the endif that
closes "if AARCH32_EL0".

Signed-off-by: liviyifan <344781483+liviyifan@users.noreply.github.com>
(cherry picked from commit 4a98edc1726f114f1c20ffa81bcb133efe885bdf)
(cherry picked from commit c319e02afe097a5256f3019041b9f4a6729f475b)
---
 arch/arm64/Kconfig           | 6 +++---
 arch/arm64/Kconfig.platforms | 2 +-
 2 files changed, 4 insertions(+), 4 deletions(-)

--- a/arch/arm64/Kconfig
+++ b/arch/arm64/Kconfig
@@ -588,7 +588,7 @@ config ARM64_ERRATUM_834220
 
 config ARM64_ERRATUM_1742098
 	bool "Cortex-A57/A72: 1742098: ELR recorded incorrectly on interrupt taken between cryptographic instructions in a sequence"
-	depends on COMPAT
+	depends on AARCH32_EL0
 	default y
 	help
 	  This option removes the AES hwcap for aarch32 user-space to
@@ -654,7 +654,7 @@ config ARM64_ERRATUM_1024718
 config ARM64_ERRATUM_1418040
 	bool "Cortex-A76/Neoverse-N1: MRC read following MRRC read of specific Generic Timer in AArch32 might give incorrect result"
 	default y
-	depends on COMPAT
+	depends on AARCH32_EL0
 	help
 	  This option adds a workaround for ARM Cortex-A76/Neoverse-N1
 	  errata 1188873 and 1418040.
@@ -1936,7 +1936,7 @@ config SETEND_EMULATION
 	  If unsure, say Y
 endif # ARMV8_DEPRECATED
 
-endif # COMPAT
+endif # AARCH32_EL0
 
 menu "ARMv8.1 architectural features"
 
--- a/arch/arm64/Kconfig.platforms
+++ b/arch/arm64/Kconfig.platforms
@@ -213,7 +213,7 @@ config ARCH_LAYERSCAPE
 config ARCH_MXC
 	bool "NXP i.MX SoC family"
 	select ARM64_ERRATUM_843419
-	select ARM64_ERRATUM_845719 if COMPAT
+	select ARM64_ERRATUM_845719 if AARCH32_EL0
 	select IMX_GPCV2
 	select IMX_GPCV2_PM_DOMAINS
 	select PM
