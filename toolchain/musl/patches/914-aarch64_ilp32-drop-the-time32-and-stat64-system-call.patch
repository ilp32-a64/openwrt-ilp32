diff --git a/arch/aarch64_ilp32/kstat.h b/arch/aarch64_ilp32/kstat.h
index bb2c5d27..e69de29b 100644
--- a/arch/aarch64_ilp32/kstat.h
+++ b/arch/aarch64_ilp32/kstat.h
@@ -1,22 +0,0 @@
-/* struct stat64 of the kernel for ILP32: the AArch32 layout (arm64 asm/stat.h) */
-struct kstat {
-	dev_t st_dev;
-	int __st_dev_padding;
-	long __st_ino_truncated;
-	mode_t st_mode;
-	nlink_t st_nlink;
-	uid_t st_uid;
-	gid_t st_gid;
-	dev_t st_rdev;
-	int __st_rdev_padding;
-	off_t st_size;
-	blksize_t st_blksize;
-	blkcnt_t st_blocks;
-	long st_atime_sec;
-	long st_atime_nsec;
-	long st_mtime_sec;
-	long st_mtime_nsec;
-	long st_ctime_sec;
-	long st_ctime_nsec;
-	ino_t st_ino;
-};
diff --git a/arch/aarch64_ilp32/syscall_arch.h b/arch/aarch64_ilp32/syscall_arch.h
index ed5ab635..376a3a72 100644
--- a/arch/aarch64_ilp32/syscall_arch.h
+++ b/arch/aarch64_ilp32/syscall_arch.h
@@ -89,3 +89,11 @@ static inline long __syscall6(long n, long a, long b, long c, long d, long e, lo
 #define VDSO_CGT32_VER "LINUX_4.12"
 #define VDSO_CGT_SYM "__kernel_clock_gettime64"
 #define VDSO_CGT_VER "LINUX_4.12"
+
+/* The time32 and stat64 system calls are not in bits/syscall.h (their
+ * types do not match the 64-bit time_t), as for riscv32; only
+ * settimeofday_time32 is, under its arm name, for callers that set just the
+ * timezone (busybox hwclock). clock_nanosleep.c still names SYS_nanosleep in
+ * its fallback for kernels without the time64 calls, which ILP32 kernels
+ * always have; it is never reached. */
+#define SYS_nanosleep 101
